# ─── Required everywhere ─────────────────────────────────────────────
# 32+ random characters. Signs rate-limit keys and dev storage URLs.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# ─── Required in production (optional locally) ───────────────────────
# Supabase Postgres. On Vercel use the *transaction pooler* URL (port 6543).
# Leave unset locally to use the embedded PGlite database in .data/.
DATABASE_URL=

# Cloudinary (Settings → API Keys). Server-only; never exposed to the browser.
# Leave unset locally to store photos on disk in .data/storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Needed once, to create the journal on a fresh deployment. Keeps strangers
# from claiming your instance before you do. Any 8+ character string.
SETUP_CODE=
